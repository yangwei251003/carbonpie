/* ── 页面整体 ── */
.page {
  height: 100vh;
  background-color: #F7F6F2;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ── 顶部标题栏 ── */
.header {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  padding-top: 60rpx;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #E8E8E4;
}

.header-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #134234;
  letter-spacing: 1rpx;
}

/* ── 滚动区域 ── */
.scroll-area {
  flex: 1;
  height: 0;
}

/* ── 头像区域 ── */
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 36rpx;
}

.avatar-ring {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  border: 6rpx solid #134234;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  background-color: #FFFFFF;
}

.avatar-inner {
  width: 140rpx;
  height: 140rpx;
  border-radius: 70rpx;
  background-color: #E8F5E9;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-icon {
  font-size: 64rpx;
}

.user-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 12rpx;
}

.level-tag {
  background-color: #134234;
  border-radius: 40rpx;
  padding: 6rpx 28rpx;
}

.level-tag-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 1rpx;
}

.cloud-status {
  margin-top: 16rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #eef2ef;
  color: #5f6b64;
  font-size: 22rpx;
}

.cloud-status-enabled {
  background: #e8f5e9;
  color: #134234;
}

.stats-row {
  display: flex;
  margin: 0 28rpx 24rpx;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.stat-card {
  flex: 1;
  padding: 28rpx 24rpx;
}

.stat-card-right {
  border-left: 1rpx solid #E8E8E4;
}

.stat-label {
  font-size: 20rpx;
  font-weight: 700;
  color: #9E9E9E;
  letter-spacing: 1rpx;
  margin-bottom: 8rpx;
  display: block;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 800;
  color: #1A1A1A;
  letter-spacing: -1rpx;
  display: block;
  margin-bottom: 4rpx;
}

.stat-sub {
  font-size: 22rpx;
  color: #9E9E9E;
  display: block;
}

/* ── 碳币余额卡片 ── */
.coins-card {
  display: flex;
  align-items: center;
  margin: 0 28rpx 36rpx;
  background: linear-gradient(135deg, #FEF3C7, #FDE68A);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid #FCD34D;
}

.coins-icon {
  font-size: 44rpx;
  margin-right: 16rpx;
}

.coins-info {
  flex: 1;
}

.coins-label {
  font-size: 22rpx;
  color: #78716C;
  display: block;
  margin-bottom: 2rpx;
}

.coins-value {
  font-size: 40rpx;
  font-weight: 800;
  color: #92400E;
  letter-spacing: -1rpx;
  display: block;
}

.go-shop-btn {
  background-color: #92400E;
  border-radius: 16rpx;
  padding: 12rpx 24rpx;
}

.go-shop-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
}

/* ── 分组标签 ── */
.group-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #9E9E9E;
  letter-spacing: 2rpx;
  padding: 0 28rpx;
  margin-bottom: 12rpx;
  display: block;
}

/* ── 列表组 ── */
.list-group {
  margin: 0 28rpx 32rpx;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.list-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
}

.list-item-border {
  border-bottom: 1rpx solid #F0EFEB;
}

.list-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background-color: #E8F5E9;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.list-icon-text {
  font-size: 32rpx;
}

.list-item-content {
  flex: 1;
  min-width: 0;
}

.list-item-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1A1A1A;
  display: block;
}

.list-item-sub {
  font-size: 22rpx;
  color: #9E9E9E;
  margin-top: 4rpx;
  display: block;
}

.list-arrow {
  font-size: 36rpx;
  color: #C0C0C0;
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* ── 危险操作区 ── */
.danger-card {
  margin: 0 28rpx 24rpx;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  border: 1rpx solid #FFDAD6;
}

.danger-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
}

.danger-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.danger-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #B3261E;
}

/* ── 版本号 ── */
.version-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0 24rpx;
}

.version-text {
  font-size: 22rpx;
  color: #BDBDBD;
  display: block;
}

.version-sub {
  font-size: 20rpx;
  color: #D5D5D5;
  margin-top: 8rpx;
  display: block;
}

/* ── 弹窗 ── */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-box {
  width: 560rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 16rpx;
  display: block;
}

.modal-msg {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 32rpx;
  display: block;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 76rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cancel-btn {
  background-color: #F5F5F5;
}

.confirm-btn {
  background-color: #B3261E;
}

.modal-btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #666666;
}

.confirm-btn-text {
  color: #FFFFFF;
}

/* ── Toast 提示 ── */
.snack-bar {
  position: fixed;
  bottom: 120rpx;
  left: 50%;
  transform: translateX(-50%);
  background-color: #323232;
  border-radius: 12rpx;
  padding: 16rpx 32rpx;
  z-index: 1000;
}

.snack-text {
  font-size: 26rpx;
  color: #FFFFFF;
}
