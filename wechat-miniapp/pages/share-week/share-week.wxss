.container {
  padding: 24rpx;
  padding-bottom: 140rpx;
  background: #f5f7f5;
  min-height: 100vh;
  box-sizing: border-box;
}

.poster {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
}

.poster-header {
  background: linear-gradient(160deg, #134234, #2a6b54);
  color: #fff;
  padding: 40rpx 32rpx 32rpx;
  text-align: center;
}

.poster-app {
  font-size: 22rpx;
  opacity: 0.7;
  letter-spacing: 2rpx;
}

.poster-title {
  font-size: 40rpx;
  font-weight: 800;
  margin-top: 12rpx;
}

.poster-date {
  font-size: 24rpx;
  opacity: 0.65;
  margin-top: 8rpx;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx;
  gap: 16rpx;
}

.stat-card {
  width: calc(33.33% - 12rpx);
  box-sizing: border-box;
  background: #f2f8f4;
  border-radius: 16rpx;
  padding: 20rpx 16rpx;
  text-align: center;
}

.stat-label {
  font-size: 22rpx;
  color: #6a736d;
}

.stat-value {
  font-size: 34rpx;
  font-weight: 800;
  color: #134234;
  margin-top: 8rpx;
}

.stat-value.green {
  color: #16a34a;
}

.card {
  margin: 24rpx;
  background: #f9fbf9;
  border-radius: 16rpx;
  padding: 24rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #134234;
  margin-bottom: 16rpx;
}

.top-action {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.top-action-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #16a34a;
}

.top-action-count {
  font-size: 24rpx;
  color: #6a736d;
}

/* Chart */
.chart {
  padding-top: 8rpx;
}

.chart-bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 240rpx;
}

.chart-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.chart-value {
  font-size: 18rpx;
  color: #16a34a;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.chart-track {
  flex: 1;
  width: 40rpx;
  background: #e8f5e9;
  border-radius: 8rpx;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
}

.chart-bar {
  width: 100%;
  background: linear-gradient(to top, #16a34a, #4ade80);
  border-radius: 8rpx;
  transition: height 0.6s ease;
  min-height: 0;
}

.chart-label {
  font-size: 20rpx;
  color: #6a736d;
  margin-top: 8rpx;
}

.poster-footer {
  text-align: center;
  padding: 32rpx 24rpx 40rpx;
  background: #f9fbf9;
}

.poster-nick {
  font-size: 28rpx;
  font-weight: 700;
  color: #134234;
}

.poster-slogan {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 8rpx;
}

.empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

.empty-text {
  color: #6a736d;
  font-size: 28rpx;
}

.save-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}

.save-btn {
  background: #134234;
  color: #fff;
  border: none;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  height: 88rpx;
  line-height: 88rpx;
}
