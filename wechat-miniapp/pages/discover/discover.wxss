/* 发现页整体 */
.page {
  min-height: 100vh;
  background-color: #F7F6F2;
  display: flex;
  flex-direction: column;
}

/* ── 顶部 Header ── */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 40rpx;
  padding-top: 100rpx;
  padding-bottom: 24rpx;
  background-color: #F7F6F2;
}
.header-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.avatar-circle {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background-color: #D9F4E8;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-icon {
  font-size: 28rpx;
}
.header-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #134234;
}
.bell-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background-color: #EEEEEA;
  display: flex;
  align-items: center;
  justify-content: center;
}
.bell-icon {
  font-size: 32rpx;
}

/* ── Tab 切换 ── */
.tab-bar {
  display: flex;
  padding: 16rpx 40rpx 24rpx;
  gap: 16rpx;
  background-color: #F7F6F2;
}
.tab-btn {
  flex: 1;
  padding: 16rpx 0;
  border-radius: 24rpx;
  text-align: center;
  background-color: #EEEEEA;
}
.tab-active {
  background-color: #134234;
}
.tab-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #999;
}
.tab-text-active {
  color: #FFFFFF;
}

/* ── 滚动内容区 ── */
.content-scroll {
  flex: 1;
  height: 0;
}
.content {
  padding: 32rpx 32rpx 0;
}

/* ── 低碳百科馆卡片 ── */
.editorial-card {
  background: linear-gradient(135deg, #163D34, #1A5C45);
  border-radius: 36rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
}
.editorial-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
}
.editorial-text-wrap {
  flex: 1;
}
.editorial-kicker {
  color: #BFEBD8;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
}
.editorial-title {
  color: #FFFFFF;
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 900;
}
.editorial-spark {
  width: 80rpx;
  height: 80rpx;
  border-radius: 28rpx;
  background-color: rgba(255, 255, 255, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}
.editorial-desc {
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  line-height: 36rpx;
  margin-top: 20rpx;
  display: block;
}
.editorial-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 24rpx;
}
.editorial-pill {
  color: #173D34;
  background-color: #D9F4E8;
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
  font-size: 20rpx;
  font-weight: 900;
}

/* ── 搜索栏 ── */
.search-bar {
  display: flex;
  align-items: center;
  background-color: #EEEEEA;
  border-radius: 28rpx;
  padding: 18rpx 28rpx;
  margin-bottom: 24rpx;
  gap: 16rpx;
}
.search-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}
.search-placeholder {
  color: #999;
  font-size: 28rpx;
}
.search-clear {
  font-size: 28rpx;
  color: #999;
  padding: 8rpx;
}

/* ── 分类筛选横滑 ── */
.filter-scroll {
  margin-bottom: 36rpx;
  white-space: nowrap;
}
.filter-list {
  display: inline-flex;
  gap: 16rpx;
}
.filter-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 28rpx;
  border-radius: 32rpx;
  background-color: #D9F4E8;
  flex-shrink: 0;
}
.filter-active {
  background-color: #134234;
}
.filter-icon {
  font-size: 22rpx;
}
.filter-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #134234;
}
.filter-text-active {
  color: #FFFFFF;
}

/* ── 精选 Banner ── */
.featured-banner {
  height: 360rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #1A5C45, #0D3B2E);
  margin-bottom: 40rpx;
  position: relative;
  overflow: hidden;
}
.featured-bg-img {
  position: absolute;
  width: 100%;
  height: 100%;
  z-index: 0;
}
.featured-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.25);
  z-index: 1;
}
.featured-content {
  position: relative;
  z-index: 2;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  height: 100%;
  box-sizing: border-box;
}
.featured-badge {
  background-color: #E8A838;
  border-radius: 12rpx;
  padding: 6rpx 18rpx;
  align-self: flex-start;
  margin-bottom: 16rpx;
}
.featured-badge-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #FFFFFF;
}
.featured-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 10rpx;
  display: block;
}
.featured-subtitle {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ── Section Header ── */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
}
.section-count {
  font-size: 24rpx;
  color: #999;
}

/* ── 文章卡片 ── */
.article-card {
  display: flex;
  background-color: #FFFFFF;
  border-radius: 28rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  border: 1rpx solid #EEEEEA;
}
.article-thumb {
  width: 200rpx;
  min-height: 200rpx;
  background-color: #D9F4E8;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}
.article-thumb-img {
  width: 100%;
  height: 100%;
}
.thumb-placeholder {
  font-size: 48rpx;
}
.article-info {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.article-title-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 38rpx;
}
.article-excerpt {
  font-size: 22rpx;
  color: #999;
  line-height: 32rpx;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.article-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.meta-icon {
  font-size: 20rpx;
}
.meta-text {
  font-size: 20rpx;
  color: #999;
}
.article-tag {
  background-color: #D9F4E8;
  border-radius: 10rpx;
  padding: 4rpx 14rpx;
  margin-left: auto;
}
.article-tag-text {
  font-size: 18rpx;
  color: #134234;
  font-weight: 600;
}

/* ── 加载 & 空状态 ── */
.loading-wrap {
  padding: 80rpx 0;
  text-align: center;
}
.loading-text {
  font-size: 26rpx;
  color: #999;
}
.empty-wrap {
  padding: 80rpx 0;
  text-align: center;
}
.empty-icon {
  font-size: 64rpx;
  display: block;
  margin-bottom: 16rpx;
}
.empty-text {
  font-size: 26rpx;
  color: #999;
}

/* ══════════════════════════════
   社区挑战 Tab
   ══════════════════════════════ */

.community-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1A1A1A;
  margin-bottom: 8rpx;
  display: block;
}
.community-subtitle {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 32rpx;
  display: block;
}

/* 好友动态 Header */
.feed-header-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  background-color: #FFFFFF;
  border-radius: 32rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #EEEEEA;
}
.feed-header-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1A1A1A;
  display: block;
}
.feed-header-sub {
  color: #999;
  font-size: 22rpx;
  margin-top: 6rpx;
  display: block;
}
.feed-header-btn {
  background-color: #134234;
  border-radius: 20rpx;
  padding: 16rpx 28rpx;
  flex-shrink: 0;
}
.feed-header-btn-text {
  color: #FFFFFF;
  font-weight: 800;
  font-size: 22rpx;
}

/* 好友动态卡片 */
.friend-feed-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 40rpx;
}
.friend-feed-card {
  background-color: #FFFFFF;
  border-radius: 28rpx;
  overflow: hidden;
  border: 1rpx solid #EEEEEA;
}
.friend-feed-body {
  padding: 28rpx;
}
.friend-feed-top {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.friend-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background-color: #D9F4E8;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.friend-avatar-text {
  color: #134234;
  font-weight: 900;
  font-size: 26rpx;
}
.friend-info {
  flex: 1;
}
.friend-name {
  color: #1A1A1A;
  font-weight: 800;
  font-size: 26rpx;
  display: block;
}
.friend-time {
  color: #999;
  font-size: 20rpx;
  margin-top: 4rpx;
  display: block;
}
.friend-kg {
  color: #E8A838;
  font-weight: 900;
  font-size: 24rpx;
  flex-shrink: 0;
}
.friend-action {
  color: #134234;
  font-size: 30rpx;
  font-weight: 900;
  margin-top: 20rpx;
  display: block;
}
.friend-summary {
  color: #999;
  line-height: 36rpx;
  font-size: 22rpx;
  margin-top: 10rpx;
  display: block;
}

/* 精选挑战卡片 */
.challenge-card {
  background: linear-gradient(135deg, #134234, #1A5C45);
  border-radius: 36rpx;
  padding: 36rpx;
  margin-bottom: 40rpx;
  position: relative;
  overflow: hidden;
}
.challenge-bg-decoration {
  position: absolute;
  right: -30rpx;
  top: -30rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.06);
}
.challenge-badge {
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 14rpx;
  padding: 8rpx 18rpx;
  align-self: flex-start;
  margin-bottom: 16rpx;
  display: inline-block;
}
.challenge-badge-text {
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 600;
}
.challenge-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #FFFFFF;
  margin-bottom: 28rpx;
  display: block;
}
.challenge-progress-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 14rpx;
  display: block;
}
.progress-bold {
  font-weight: 700;
}
.challenge-bar {
  height: 12rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 6rpx;
  margin-bottom: 28rpx;
  overflow: hidden;
}
.challenge-bar-fill {
  height: 12rpx;
  background-color: #D9F4E8;
  border-radius: 6rpx;
}
.challenge-btn {
  background-color: rgba(255, 255, 255, 0.15);
  border-radius: 20rpx;
  padding: 20rpx 36rpx;
  align-self: flex-start;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  display: inline-block;
}
.challenge-btn-text {
  color: #FFFFFF;
  font-weight: 600;
  font-size: 26rpx;
}

/* 活跃小组 */
.group-card {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 28rpx;
  padding: 24rpx;
  gap: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #EEEEEA;
}
.group-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  background-color: #D9F4E8;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.group-icon {
  font-size: 36rpx;
}
.group-info {
  flex: 1;
}
.group-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
}
.group-count {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
  display: block;
}
.join-btn {
  background-color: #D9F4E8;
  border-radius: 18rpx;
  padding: 14rpx 28rpx;
  flex-shrink: 0;
}
.join-btn-text {
  font-weight: 600;
  color: #134234;
  font-size: 24rpx;
}

/* 社区影响力统计 */
.impact-card {
  display: flex;
  align-items: center;
  background-color: #EEEEEA;
  border-radius: 36rpx;
  padding: 36rpx;
  margin-top: 32rpx;
  overflow: hidden;
}
.impact-info {
  flex: 1;
}
.impact-label {
  font-size: 22rpx;
  color: #999;
  letter-spacing: 1rpx;
  display: block;
}
.impact-value {
  font-size: 64rpx;
  font-weight: 800;
  color: #1A1A1A;
  letter-spacing: -2rpx;
  margin: 8rpx 0;
  display: block;
}
.impact-sub {
  font-size: 22rpx;
  color: #999;
  display: block;
}
.impact-tree {
  font-size: 100rpx;
  flex-shrink: 0;
  opacity: 0.5;
}
