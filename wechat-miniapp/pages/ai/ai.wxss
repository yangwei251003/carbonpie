.guide-page {
  min-height: 100vh;
  background: #F7F6F2;
}

.guide-scroll {
  height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
}

.hero-card {
  border-radius: 24rpx;
  padding: 34rpx 30rpx;
  color: #ffffff;
  background: linear-gradient(160deg, #103b31, #2f6d4f);
}

.hero-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 46rpx;
  background: rgba(255, 255, 255, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-bottom: 22rpx;
}

.hero-kicker {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.72);
  letter-spacing: 1rpx;
}

.hero-title {
  margin-top: 10rpx;
  font-size: 44rpx;
  font-weight: 800;
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.84);
}

.today-card,
.guide-card,
.tool-card {
  background: #ffffff;
  border: 1rpx solid #edf0eb;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.today-card {
  margin-top: 22rpx;
  border-radius: 20rpx;
  padding: 26rpx;
}

.today-label {
  color: #6a736d;
  font-size: 22rpx;
}

.today-text {
  margin-top: 10rpx;
  color: #173129;
  font-size: 30rpx;
  line-height: 1.55;
  font-weight: 700;
}

.today-btn {
  margin: 24rpx 0 0;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 999rpx;
  background: #134234;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.section-head {
  margin: 34rpx 4rpx 16rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #173129;
}

.section-sub {
  font-size: 22rpx;
  color: #6a736d;
}

.guide-card {
  border-radius: 20rpx;
  padding: 22rpx;
  margin-bottom: 18rpx;
}

.guide-card-open {
  border-color: #c9ded0;
}

.card-main {
  display: flex;
  align-items: flex-start;
}

.card-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 18rpx;
  background: #eff7f2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.card-content {
  flex: 1;
  min-width: 0;
}

.card-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.card-title {
  color: #173129;
  font-size: 30rpx;
  font-weight: 800;
}

.card-tag {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #e7efe9;
  color: #134234;
  font-size: 20rpx;
}

.card-summary {
  margin-top: 8rpx;
  color: #5f6f67;
  font-size: 24rpx;
  line-height: 1.55;
}

.card-saving {
  margin-top: 10rpx;
  color: #9d6d14;
  font-size: 22rpx;
  font-weight: 700;
}

.card-arrow {
  color: #8a958d;
  font-size: 34rpx;
  padding-left: 12rpx;
}

.step-list {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf0eb;
}

.step-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 14rpx;
}

.step-item:last-child {
  margin-bottom: 0;
}

.step-index {
  width: 34rpx;
  height: 34rpx;
  border-radius: 17rpx;
  background: #134234;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 34rpx;
  text-align: center;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.step-text {
  flex: 1;
  color: #31413a;
  font-size: 24rpx;
  line-height: 1.5;
}

.tool-row {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.tool-card {
  flex: 1;
  border-radius: 20rpx;
  padding: 24rpx 18rpx;
}

.tool-icon {
  font-size: 42rpx;
}

.tool-title {
  margin-top: 12rpx;
  color: #173129;
  font-size: 28rpx;
  font-weight: 800;
}

.tool-sub {
  margin-top: 6rpx;
  color: #6a736d;
  font-size: 22rpx;
}

.bottom-space {
  height: 48rpx;
}
