.hero {
  background: linear-gradient(160deg, #123d33, #2a6b57);
  color: #fff;
  border-radius: 28rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.hero-kicker {
  font-size: 22rpx;
  color: rgba(255,255,255,0.72);
  letter-spacing: 2rpx;
}

.hero-title {
  margin-top: 10rpx;
  font-size: 40rpx;
  font-weight: 800;
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(255,255,255,0.84);
}

.form-card,
.panel {
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #173129;
  margin-bottom: 18rpx;
}

.action-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.action-chip {
  border-radius: 22rpx;
  padding: 18rpx;
  width: 31%;
  box-sizing: border-box;
  margin-bottom: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.action-icon {
  font-size: 36rpx;
  margin-bottom: 6rpx;
}

.action-chip-active {
  box-shadow: 0 10rpx 24rpx rgba(19, 66, 52, 0.18);
}

.action-name {
  font-size: 28rpx;
  font-weight: 800;
  color: #173129;
}

.action-unit {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #5d665f;
}

.active-text {
  color: #ffffff;
}

.active-sub {
  color: rgba(255,255,255,0.76);
}

.field {
  margin-top: 20rpx;
}

.field-label {
  font-size: 24rpx;
  color: #53615b;
  margin-bottom: 10rpx;
}

.field-input,
.field-textarea {
  width: 100%;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #f3f4ef;
  padding: 20rpx;
  font-size: 26rpx;
  color: #173129;
}

.field-textarea {
  min-height: 140rpx;
}

.button-row {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.primary-btn,
.ghost-btn {
  flex: 1;
  margin: 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.primary-btn {
  background: #134234;
  color: #fff;
}

.ghost-btn {
  background: #d8ecdf;
  color: #134234;
}

.record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf0eb;
}

.record-item:last-child {
  border-bottom: none;
}

.record-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #173129;
}

.record-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6b746d;
  line-height: 1.6;
}

.record-side {
  text-align: right;
}

.record-carbon {
  font-size: 26rpx;
  font-weight: 800;
  color: #b45309;
}

.record-reward {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #134234;
}

.photo-scroll {
  white-space: nowrap;
}

.photo-row {
  display: inline-flex;
  gap: 16rpx;
}

.photo-card {
  width: 260rpx;
  white-space: normal;
}

.photo-img {
  width: 260rpx;
  height: 190rpx;
  border-radius: 22rpx;
  background: #edf0eb;
}

.photo-title {
  margin-top: 12rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #173129;
}

.photo-note {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #6b746d;
}

.empty {
  color: #6b746d;
  font-size: 24rpx;
  line-height: 1.7;
}
