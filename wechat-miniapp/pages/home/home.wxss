.hero {
  background: linear-gradient(160deg, #103b31, #25594a);
  color: #fff;
  border-radius: 28rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.hero-kicker {
  font-size: 22rpx;
  color: rgba(255,255,255,0.72);
  letter-spacing: 2rpx;
}

.hero-title {
  margin-top: 10rpx;
  font-size: 42rpx;
  font-weight: 800;
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(255,255,255,0.82);
}

.hero-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.hero-primary,
.hero-secondary {
  margin: 0;
  flex: 1;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.hero-primary {
  background: #ffffff;
  color: #134234;
}

.hero-secondary {
  background: rgba(255,255,255,0.14);
  color: #ffffff;
}

.overview-grid {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.overview-card {
  padding: 20rpx;
  width: 31%;
  box-sizing: border-box;
}

.overview-label {
  color: #68716b;
  font-size: 22rpx;
}

.overview-value {
  margin-top: 12rpx;
  color: #173129;
  font-size: 34rpx;
  font-weight: 800;
}

/* ── 本周趋势 ── */
.week-card {
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.week-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.week-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #134234;
}

.week-sub {
  font-size: 22rpx;
  color: #6a736d;
  margin-top: 4rpx;
}

.trend-chart {
  margin-top: 12rpx;
}

.trend-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 200rpx;
  padding: 0 10rpx;
}

.trend-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  height: 100%;
  justify-content: flex-end;
}

.trend-bar-wrap {
  width: 40rpx;
  height: 140rpx;
  background: #f0f5f2;
  border-radius: 12rpx;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}

.trend-bar {
  width: 100%;
  background: linear-gradient(180deg, #134234, #2a7d5f);
  border-radius: 12rpx;
  min-height: 8rpx;
  transition: height 0.5s;
}

.trend-val {
  font-size: 18rpx;
  color: #134234;
  font-weight: 600;
  margin-top: 6rpx;
}

.trend-label {
  font-size: 18rpx;
  color: #6a736d;
  margin-top: 4rpx;
}

/* ── 快捷入口 ── */
.quick-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.quick-item {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border: 1rpx solid #edf0eb;
}

.quick-item:active {
  transform: scale(0.96);
}

.quick-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.quick-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #173129;
}

.quick-desc {
  font-size: 18rpx;
  color: #6a736d;
  margin-top: 4rpx;
}

/* ── 文章卡片 ── */
.feature-card {
  padding: 0;
  margin-bottom: 24rpx;
  background: #ffffff;
  overflow: hidden;
}

.feature-hero {
  width: 100%;
  height: 320rpx;
  background-color: #e8eae9;
}

.feature-content {
  padding: 24rpx;
  background: linear-gradient(160deg, #fff9ea, #f4f6ef);
}

.feature-kicker {
  color: #9d6d14;
  font-size: 22rpx;
  font-weight: 800;
}

.feature-title {
  margin-top: 12rpx;
  color: #173129;
  font-size: 32rpx;
  line-height: 1.45;
  font-weight: 800;
}

.feature-summary {
  margin-top: 12rpx;
  color: #66736d;
  font-size: 24rpx;
  line-height: 1.7;
}

/* ── 环境雷达 ── */
.radar-card {
  padding: 24rpx;
}

.radar-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.radar-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #134234;
}

.radar-source {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6a736d;
}

.relocate-btn {
  margin: 0;
  padding: 0 24rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  background: #134234;
  color: #fff;
  font-size: 22rpx;
}

.stats {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.stat {
  flex: 1;
  border-radius: 20rpx;
  background: #eff7f2;
  padding: 18rpx;
}

.stat-label {
  color: #6a736d;
  font-size: 22rpx;
}

.stat-value {
  margin-top: 10rpx;
  color: #134234;
  font-size: 38rpx;
  font-weight: 800;
}

.tip-list {
  margin-top: 24rpx;
}

.tip-item {
  display: flex;
  margin-bottom: 12rpx;
}

.tip-dot {
  color: #134234;
  margin-right: 10rpx;
}

.tip-text {
  flex: 1;
  color: #31413a;
  font-size: 24rpx;
  line-height: 1.7;
}

.loading {
  margin-top: 24rpx;
  color: #6a736d;
  font-size: 24rpx;
}

/* ── 最近记录 ── */
.recent-card {
  padding: 24rpx;
  margin-top: 20rpx;
}

.recent-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.recent-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #173129;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.mini-link {
  margin: 0;
  padding: 0 20rpx;
  height: 54rpx;
  line-height: 54rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #e7efe9;
  color: #134234;
}

.mini-record {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf0eb;
}

.mini-record:last-child {
  border-bottom: none;
}

.mini-record-title {
  color: #173129;
  font-size: 28rpx;
  font-weight: 700;
}

.mini-record-meta {
  margin-top: 8rpx;
  color: #6a736d;
  font-size: 22rpx;
}

.mini-record-carbon {
  color: #b45309;
  font-size: 24rpx;
  font-weight: 800;
}
