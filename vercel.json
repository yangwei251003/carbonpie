{
  "version": 2,
  "installCommand": "npm ci",
  "buildCommand": "npm run export:web",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/articles", "destination": "/articles.html" },
    { "source": "/ai", "destination": "/ai.html" },
    { "source": "/grow", "destination": "/grow.html" },
    { "source": "/log", "destination": "/log/index.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/profile", "destination": "/profile.html" },
    { "source": "/friends", "destination": "/friends.html" },
    { "source": "/circle-feed", "destination": "/circle-feed.html" },
    { "source": "/share-week", "destination": "/share-week.html" },
    { "source": "/photo-album", "destination": "/photo-album.html" },
    { "source": "/photo-checkin", "destination": "/photo-checkin.html" },
    { "source": "/profile-edit", "destination": "/profile-edit.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/credits", "destination": "/credits.html" }
  ]
}
